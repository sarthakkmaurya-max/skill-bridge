# Backend API URL (for production deployments like Vercel)
# Leave blank for local development to use Vite dev server proxy
VITE_API_URL=https://your-backend-url.onrender.com

# Optional: Supabase Authentication & Database Integration
# Set these to your live Supabase project credentials to enable direct Supabase Auth
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key