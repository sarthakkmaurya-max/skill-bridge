{
  "name": "skillbridge",
  "version": "1.0.0",
  "description": "SkillBridge — Academia–Industry Collaboration Portal",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,cyan\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "node backend/src/server.js",
    "seed": "npm run seed --prefix backend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend"
  },
  "keywords": ["skillbridge", "education", "recruitment", "career-readiness"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
